<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.avionix</groupId>
  <artifactId>avionix-parent</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>
  <name>AVIONIX ATC Platform</name>
  <description>Air Traffic Control Management System — Spring Boot Microservices</description>

  <modules>
    <module>fdps-service</module>
    <module>snet-service</module>
    <module>surveillance-service</module>
    <module>coordination-service</module>
    <module>weather-service</module>
    <module>analytics-service</module>
    <module>ml-service</module>
    <module>ingest-service</module>
    <module>gateway-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <springdoc.version>2.5.0</springdoc.version>
    <mapstruct.version>1.5.5.Final</mapstruct.version>
    <keycloak.version>24.0.4</keycloak.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- OpenAPI / Swagger -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <!-- MapStruct -->
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>
