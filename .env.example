# ─── DATABASE ─────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=avionix
DB_USER=avionix
DB_PASSWORD=change_me_strong_password
DB_POOL_MAX=20
DB_SSL=false

# ─── KEYCLOAK ─────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=avionix
KEYCLOAK_CLIENT_ID=avionix-services
KEYCLOAK_CLIENT_SECRET=change_me_client_secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_admin_password
KC_HOSTNAME=localhost
KC_DB_PASSWORD=change_me_kc_db_password

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ─── SERVICE PORTS ────────────────────────────────────────────────────────────
FDPS_PORT=3001
SNET_PORT=3002
SURVEILLANCE_PORT=3003
COORDINATION_PORT=3004
WEATHER_PORT=3005
ANALYTICS_PORT=3006
ML_PORT=3007

# ─── MONITORING ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
