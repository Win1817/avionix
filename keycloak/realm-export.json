{
  "realm": "avionix",
  "displayName": "AVIONIX ATC Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "accessTokenLifespan": 300,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": true,
  "accessCodeLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN",
        "description": "Full system access \u2014 manage all services, users, and configurations",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": [
            "10"
          ]
        }
      },
      {
        "name": "ATC_SUPERVISOR",
        "description": "Supervises controllers, approves overrides, views all sectors",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": [
            "8"
          ]
        }
      },
      {
        "name": "ATC_CONTROLLER",
        "description": "Active air traffic controller \u2014 full read/write on assigned sector",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": [
            "6"
          ]
        }
      },
      {
        "name": "ATC_TRAINEE",
        "description": "Trainee controller under supervision \u2014 read-only with limited actions",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": [
            "4"
          ]
        }
      },
      {
        "name": "PILOT",
        "description": "Pilot \u2014 limited access to own flight data and clearances",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": [
            "3"
          ]
        }
      },
      {
        "name": "OPERATIONS_MANAGER",
        "description": "Airport/Ops manager \u2014 read-all, no flight modification",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": [
            "5"
          ]
        }
      },
      {
        "name": "SAFETY_OFFICER",
        "description": "Access to all safety alerts, incidents, and reports",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": [
            "5"
          ]
        }
      },
      {
        "name": "DATA_ANALYST",
        "description": "Analytics & reporting access \u2014 read-only on all data",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": [
            "3"
          ]
        }
      },
      {
        "name": "SYSTEM_MONITOR",
        "description": "Infrastructure and system health monitoring access",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": [
            "2"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "avionix-frontend",
      "name": "AVIONIX Frontend",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://avionix.app/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://avionix.app"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ]
    },
    {
      "clientId": "avionix-services",
      "name": "AVIONIX Backend Services",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "resources": [
          {
            "name": "flights",
            "type": "flight-data",
            "scopes": [
              "read",
              "write",
              "delete"
            ]
          },
          {
            "name": "alerts",
            "type": "safety-alert",
            "scopes": [
              "read",
              "write",
              "dismiss"
            ]
          },
          {
            "name": "sectors",
            "type": "airspace-sector",
            "scopes": [
              "read",
              "assign",
              "manage"
            ]
          },
          {
            "name": "analytics",
            "type": "analytics-report",
            "scopes": [
              "read",
              "export"
            ]
          },
          {
            "name": "users",
            "type": "user-management",
            "scopes": [
              "read",
              "write",
              "delete"
            ]
          }
        ],
        "policies": [
          {
            "name": "ATC_CONTROLLER_POLICY",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"ATC_CONTROLLER\", \"required\": true}]"
            }
          },
          {
            "name": "SUPERVISOR_POLICY",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"ATC_SUPERVISOR\", \"required\": true}]"
            }
          },
          {
            "name": "ADMIN_POLICY",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"SUPER_ADMIN\", \"required\": true}]"
            }
          }
        ]
      }
    }
  ],
  "groups": [
    {
      "name": "ENROUTE_CONTROL",
      "attributes": {
        "sectorType": [
          "ENROUTE"
        ],
        "fir": [
          "RPHI"
        ]
      }
    },
    {
      "name": "APPROACH_CONTROL",
      "attributes": {
        "sectorType": [
          "APPROACH"
        ],
        "fir": [
          "RPHI"
        ]
      }
    },
    {
      "name": "TOWER_CONTROL",
      "attributes": {
        "sectorType": [
          "TOWER"
        ]
      }
    }
  ]
}
